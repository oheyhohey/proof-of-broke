{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "proof-of-broke",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": false }
}
